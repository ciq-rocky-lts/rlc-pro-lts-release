%pretrans -p <lua>
-- When this package supersedes rocky-release, %{_datadir}/rocky-release transitions
-- from a directory (upstream layout) to a symlink (CIQ layout). Remove the old
-- directory on first install so the symlink can take its place without conflicts.
if tonumber(arg[2]) == 1 then
    path = "%{_datadir}/rocky-release"
    if posix.stat(path) then
        if posix.access("%{_bindir}/rm", "x") ~= 0 then
            error("rm command not found - please remove " .. path .. " manually to continue installation")
        end
        os.execute("%{_bindir}/rm -rf " .. path)
    end
end

