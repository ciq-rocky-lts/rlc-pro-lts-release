ln -sr %{buildroot}%{_datadir}/pki/sb-certs/rockydup1.x509 %{buildroot}%{_datadir}/pki/sb-certs/kernel-dup1-s390x.der
ln -sr %{buildroot}%{_datadir}/pki/sb-certs/rockykpatch1.x509 %{buildroot}%{_datadir}/pki/sb-certs/kernel-kpatch1-s390x.der
ln -sr %{buildroot}%{_datadir}/pki/sb-certs/rocky-nvidiagpuoot101.x509 %{buildroot}%{_datadir}/pki/sb-certs/kernel-nvidiagpuoot101-s390x.der
## noarch
ln -sr %{buildroot}%{_datadir}/pki/sb-certs/rockydup1.x509 %{buildroot}%{_datadir}/pki/sb-certs/kernel-dup1-noarch.der
ln -sr %{buildroot}%{_datadir}/pki/sb-certs/rockykpatch1.x509 %{buildroot}%{_datadir}/pki/sb-certs/kernel-kpatch1-noarch.der
ln -sr %{buildroot}%{_datadir}/pki/sb-certs/rocky-nvidiagpuoot101.x509 %{buildroot}%{_datadir}/pki/sb-certs/kernel-nvidiagpuoot101-noarch.der

# symlinks for everybody
for x in $(ls %{buildroot}%{_datadir}/pki/sb-certs); do
  ln -sr %{buildroot}%{_datadir}/pki/sb-certs/${x} %{buildroot}%{_sysconfdir}/pki/sb-certs/${x}
done
# end secureboot section
