%endif

################################################################################
# dnf repo section
install -d -m 0755 %{buildroot}%{_sysconfdir}/yum.repos.d
install -d -m 0755 %{buildroot}%{_sysconfdir}/dnf/vars

for f in rocky rocky-addons rocky-extras rocky-security rocky-devel; do
  cat > %{buildroot}%{_sysconfdir}/yum.repos.d/${f}.repo <<'EOF'
# RLC Repositories are configured and managed through depot.
# See depot-*.repo for RLC repository files
# Visit https://docs.ciq.com to learn more about RLC and depot.
EOF
done
echo 'vault/rocky' > %{buildroot}%{_sysconfdir}/dnf/vars/contentdir
echo 'vault/sig' > %{buildroot}%{_sysconfdir}/dnf/vars/sigcontentdir
echo '9-stream' > %{buildroot}%{_sysconfdir}/dnf/vars/stream
echo '' > %{buildroot}%{_sysconfdir}/dnf/vars/rltype

# Copy out the GPG keys
install -d -m 0755 %{buildroot}%{_sysconfdir}/pki/rpm-gpg
install -p -m 0644 %{SOURCE100} %{buildroot}%{_sysconfdir}/pki/rpm-gpg/RPM-GPG-KEY-Rocky-9
install -p -m 0644 %{SOURCE101} %{buildroot}%{_sysconfdir}/pki/rpm-gpg/RPM-GPG-KEY-CIQ
# end dnf repo section
################################################################################

################################################################################
# Anaconda installer product identification
mkdir -p %{buildroot}/%{_sysconfdir}/anaconda/product.d
BASIL_PRODUCT_NAME='Rocky Linux from CIQ'
export BASIL_PRODUCT_NAME
awk '/^product_name = Rocky Linux$/ { print "product_name = " ENVIRON["BASIL_PRODUCT_NAME"]; found=1; next } { print } END { exit(found ? 0 : 1) }' \
  < %{_sysconfdir}/anaconda/product.d/rocky.conf \
  > %{buildroot}/%{_sysconfdir}/anaconda/product.d/rlc-pro-lts.conf \
  || { echo 'ERROR: no product_name line in upstream rocky.conf to override;'; echo 'the installer would silently ship the wrong product name.'; exit 1; }
